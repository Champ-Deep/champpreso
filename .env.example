# =====================================================
# ChampPreso environment variables
# Copy to .env (gitignored) and fill in.
# Railway / cloud deployment: paste these into the
# project's Variables tab; do not commit .env.
# =====================================================

# --- Cloud mode detection (set automatically by Railway) ---
# CHAMPPRESO_CLOUD=1
# Forces 0.0.0.0 bind + skips browser-open. Optional;
# auto-detected from RAILWAY_ENVIRONMENT, RENDER, etc.

# --- Server ---
PORT=3210
# HOST defaults: 127.0.0.1 local, 0.0.0.0 cloud

# --- Agent providers (pick one or more) ---

# Groq (recommended: free 14,400 min/day, 400-800 tok/s on Llama 3.3 70B)
# Get key: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras (fastest: 2000+ tok/s on Llama 3.3 70B; tighter rate limits)
# Get key: https://cloud.cerebras.ai/platform/keys
# CEREBRAS_API_KEY=csk-...
# CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter (universal: 200+ models, pay per token)
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# OpenAI (gpt-5.x + Realtime STT)
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5

# Ollama (local only, won't work on Railway)
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Log paths (defaults to ~/.config/champpreso/logs/) ---
# CHAMPPRESO_CACHE_LOG=
# CHAMPPRESO_DEBUG_LOG=
