    "dev": "node ./src/cli.js",
    "prepare:release-packages": "node ./scripts/prepare-release-packages.js",
    "test": "node --test",
    "start": "node ./src/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^6.0.176",
    "express": "^5.2.1",
    "open": "^11.0.0",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
