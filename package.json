{
  "name": "champpreso",
  "version": "0.14.0",
  "description": "ChampPreso: realtime visual brainstorming partner. v0.6 adds Groq (400-800 tok/s) + Cerebras (2000+ tok/s) as fast-lane agent providers. Plus Mermaid integration (14 diagram types), Aegis design, pattern library, icon vocab, confidence questions, Quick Action chips, UI Settings drawer, OpenRouter/Ollama, mid-session steering.",
  "license": "MIT",
  "author": "Sreedeep Surapaneni <deep@championsmail.com>",
  "contributors": [
    "Kun Chen <kun@kunchenguid.com> (original autopreso author)"
  ],
  "homepage": "https://github.com/Champ-Deep/champpreso#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Champ-Deep/champpreso.git"
  },
  "bugs": {
    "url": "https://github.com/Champ-Deep/champpreso/issues"
  },
  "keywords": [
    "excalidraw",
    "whiteboard",
    "presentation",
    "voice",
    "speech-to-text",
    "ai-agent",
    "moonshine",
    "openai",
    "openrouter",
    "ollama",
    "transcription",
    "cli",
    "champions-group"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
